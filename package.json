{
  "name": "tmux-mcp-ui",
  "private": true,
  "type": "module",
  "description": "Source for the tmux-mcp control UI. Built output is committed to ../ui-dist so installing tmux-mcp never needs this toolchain.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "npm run build:app && npm run build:server",
    "build:app": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/main.js",
    "test": "npm run build:server && node --test test/*.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
