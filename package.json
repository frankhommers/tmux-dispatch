{
  "name": "tmux-dispatch",
  "private": true,
  "type": "module",
  "description": "The service where a human dispatches a tmux pane to an agent that asked for one.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "npm run build:app && npm run build:server",
    "build:app": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/main.js",
    "test": "npm run build:server && node --test test/*.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankhommers/tmux-dispatch.git"
  },
  "homepage": "https://github.com/frankhommers/tmux-dispatch#readme",
  "bugs": {
    "url": "https://github.com/frankhommers/tmux-dispatch/issues"
  }
}
